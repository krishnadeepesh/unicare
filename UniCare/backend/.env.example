# UniCare Backend Production Environment Variables
# Copy this to .env and adjust values for your hosting environment

# Django Secret Key (generate a secure random 50-char string for production)
SECRET_KEY=your-production-secret-key-change-this-now

# Set DEBUG to False in production
DEBUG=False

# Comma-separated list of allowed hostnames (e.g., yourdomain.com,api.yourdomain.com,localhost)
ALLOWED_HOSTS=*

# MySQL Database Configuration
DB_NAME=db_unicare
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Alternatively, specify a single cloud DATABASE_URL:
# DATABASE_URL=mysql://user:password@host:3306/db_unicare

# CORS Configuration
# Set to False and specify exact origins in production
CORS_ALLOW_ALL=True
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://yourdomain.com

# CSRF Trusted Origins (needed for POST requests via HTTPS)
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://yourdomain.com
